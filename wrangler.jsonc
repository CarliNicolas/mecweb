{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mecsa-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [
    { "pattern": "www.mecsa.com.ar", "custom_domain": true },
    { "pattern": "mecsa.com.ar", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "mecsa-web" }
  ],
  "kv_namespaces": [
    // Datos editables del admin (site-content, news, configs) + imágenes subidas
    { "binding": "MEC_STORAGE", "id": "2b508f1bfadf40c689e45521caf27f11" }
  ],
  "images": { "binding": "IMAGES" },
  // IA de respaldo para el chat si no hay GEMINI_API_KEY
  "ai": { "binding": "AI" },
  "vars": {
    "ADMIN_USERNAME": "admin",
    "NEXT_PUBLIC_SITE_URL": "https://www.mecsa.com.ar"
  },
  "observability": { "enabled": true }
}
